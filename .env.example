# Decide One — telemetry server environment
# Copy to .env and fill in. Never commit .env.

# Credential for owner-only analytics endpoints.
# There is no default: if this is unset the server denies all owner access.
# Generate one with:  openssl rand -hex 32
OWNER_SECRET_KEY=

# Telemetry server port (default 4000)
PORT=4000

# Build-time gate for the product analytics SDK. Unset or anything other than
# 'true' compiles it out entirely, which is why production has collected
# nothing to date. Turning it on does NOT start collection: the SDK still
# requires this person, on this device, to have said yes in Settings, and the
# default there is no.
VITE_ENABLE_TELEMETRY=false

# Support channels (Menu -> Support Decide One). Each channel appears only when
# it is set, so a fork never shows someone else's payment details.
VITE_SUPPORT_UPI_ID=
VITE_SUPPORT_UPI_NAME=Decide One
VITE_SUPPORT_SPONSORS_URL=
VITE_SUPPORT_REPO_URL=

# Public legal facts embedded into the production build.
VITE_LEGAL_ENTITY=
VITE_REGISTERED_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_LEGAL_JURISDICTION=
VITE_LEGAL_EFFECTIVE_DATE=
