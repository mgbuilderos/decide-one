# Decide One — telemetry server environment
# Copy to .env and fill in. Never commit .env.

# Credential for owner-only analytics endpoints.
# There is no default: if this is unset the server denies all owner access.
# Generate one with:  openssl rand -hex 32
OWNER_SECRET_KEY=

# Telemetry server port (default 4000)
PORT=4000

# Public legal facts embedded into the production build.
VITE_LEGAL_ENTITY=
VITE_REGISTERED_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_LEGAL_JURISDICTION=
VITE_LEGAL_EFFECTIVE_DATE=
