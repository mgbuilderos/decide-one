{
  // Cloudflare hosting for Decide One.
  //
  // Pages is now part of Workers, and wrangler steers new projects here, so
  // this is a Worker serving static assets rather than a legacy Pages project.
  //
  // Nothing runs server-side: `dist` is uploaded and served directly. The app
  // is local-first and has no backend, which is the point.
  "name": "decide-one",
  "compatibility_date": "2026-09-10",
  // Keep the workers.dev URL alive. Declaring `routes` alone replaces the
  // default trigger, which is how the workers.dev address went dark when the
  // custom-domain attach failed halfway.
  "workers_dev": true,

  // The live domain. Attached 11 September 2026, once the apex CNAME to
  // decide-one.pages.dev was deleted in the dashboard — Cloudflare refuses a
  // custom domain while the hostname has externally managed records [100117],
  // and the token here has no DNS scope to clear them itself.
  //
  // That CNAME was the zone's only record; it is written down in DEPLOY.md,
  // which is the rollback to the Sites host.
  "routes": [
    { "pattern": "decideone.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Every route is the same document; the app reads ?view= from the URL.
    // Without this a refresh on any path would 404 instead of loading.
    "not_found_handling": "single-page-application"
  }
}
